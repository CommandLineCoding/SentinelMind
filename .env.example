# Application Config
PROJECT_NAME="SentielMind"
ENV="development"
HOST="0.0.0.0"
PORT=8000

# LLM Provider
LLM_PROVIDER="gemini" # groq or gemini
GROQ_API_KEY=""

# Google Gemini API Config
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"

# SIEM / Elasticsearch Config
ELASTICSEARCH_HOST="http://localhost:9200"
ELASTICSEARCH_API_KEY="your-elastic-api-key-here"
ELASTICSEARCH_INDEX_PATTERN="logs-*"
ELASTICSEARCH_VERIFY_SSL=false

# Session Config
SESSION_TTL_SECONDS=3600